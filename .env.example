# ============================================================================
# Adhera — variables de entorno. Copiar a apps/api/.env para desarrollo local.
# Valores locales de demo: NUNCA usar en el entorno público.
# En Render/Neon cargá los valores reales en el dashboard (ver docs/DEPLOY.md).
# ============================================================================

# ---- API (apps/api) ----
# Entorno lógico: development | test | production
APP_ENV=development
DATABASE_URL="postgresql://adhera:adhera_local_only@localhost:5433/adhera?schema=public"
# Conexión directa para migraciones (en Neon: la URL sin "-pooler"). En local, igual a DATABASE_URL.
DIRECT_URL="postgresql://adhera:adhera_local_only@localhost:5433/adhera?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Generá un valor propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-un-valor-aleatorio-largo"
# Simulador web público y límite anti-abuso (conversaciones nuevas por IP por hora)
SIMULATOR_ENABLED=true
SIMULATOR_STARTS_PER_HOUR=30
# Tope global de conversaciones nuevas por hora (aunque cambien las IPs)
SIMULATOR_STARTS_PER_HOUR_GLOBAL=300
# Clave compartida panel ↔ API para limitar por visitante (32+ caracteres). Definir la MISMA en apps/web.
# Sin ella, la API usa la IP del proxy del panel (un límite compartido por todos). Opcional en local.
# PROXY_SECRET=

# ---- Seed en producción (APP_ENV=production) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=          # mínimo 12 caracteres
# ADMIN_NAME=Administrador
# SEED_DEMO_DATA=true      # casos ficticios de demostración

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_ENABLED=false
# Texto que inventás vos y repetís en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (verifica la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Token de acceso (permanente de usuario del sistema; el temporal vence en 24 h)
WHATSAPP_ACCESS_TOKEN=
# Phone number ID (no es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Web (apps/web) — se leen al compilar ----
# API_URL=http://localhost:4000
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
# PROXY_SECRET=           # la misma que la API
